# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# uv.lock は **追跡する**（ignore しない）。ライブラリではなくアプリのリポジトリで、
# Dockerfile が `COPY pyproject.toml uv.lock` を、CI が `uv sync --frozen` を要求する。
# ignore していた間 CI は全 run で「Unable to find lockfile」により赤のままで、
# テストが一度も実行されていなかった。

# Node
node_modules/
.next/
dist/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Local data / scratch
/data/
*.local.json

# ベンダ参照（独自 .git を持つ公式クローン。submodule 化するまでは追跡しない。README/ADR-0001 参照）
/PaddleOCR/

# Terraform
# tfstate は RDS のマスタパスワード等を平文で持つ。絶対にコミットしない
# （リモート state を使う場合も同様）。
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
# 環境固有の ARN 等。example のみコミットする
*.tfvars
!*.tfvars.example

# ゴールデン計測の作業出力（実行のたびに変わる。ベースラインは golden/baselines/）
out/
